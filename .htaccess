Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Rutas públicas
RewriteRule ^servicios/?$ servicios.php [L,QSA]
RewriteRule ^portafolio/?$ portafolio.php [L,QSA]
RewriteRule ^contacto/?$ contacto.php [L,QSA]

# Autenticación
RewriteRule ^iniciar-sesion/?$ auth/login.php [L,QSA]
RewriteRule ^crear-cuenta/?$ auth/registro.php [L,QSA]
RewriteRule ^recuperar/?$ auth/recuperar.php [L,QSA]
RewriteRule ^restablecer/?$ auth/restablecer.php [L,QSA]
RewriteRule ^salir/?$ auth/logout.php [L,QSA]

# Panel administrador / cliente
RewriteRule ^panel/?$ route.php?section=panel [L,QSA]
RewriteRule ^solicitudes/?$ route.php?section=solicitudes [L,QSA]
RewriteRule ^mensajes/?$ route.php?section=mensajes [L,QSA]
RewriteRule ^perfil/?$ route.php?section=perfil [L,QSA]
RewriteRule ^gestion-portafolio/?$ route.php?section=gestion-portafolio [L,QSA]
RewriteRule ^gestion-contactos/?$ route.php?section=gestion-contactos [L,QSA]

# Si existe un archivo PHP con el mismo nombre, cargarlo sin mostrar .php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# Proteger archivos sensibles
<FilesMatch "^(\.env|composer\.(json|lock)|README\.md|.*\.sql)$">
    Require all denied
</FilesMatch>
